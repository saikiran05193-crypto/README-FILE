PORT=5000
NODE_ENV=development

# Database Settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=environmental_network
DB_USER=root
DB_PASSWORD=your_password
DB_DIALECT=mysql

# Set DB_DIALECT=sqlite for zero-config local testing if MySQL service is inactive
# DB_DIALECT=sqlite
# DB_STORAGE=./database/environmental_network.sqlite

# Authentication
JWT_SECRET=super_secret_environmental_network_jwt_key_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
